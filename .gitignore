# ===== 构建产物 =====
build/
dist/

# ===== 第三方依赖（vendored 开源库：opencv/tesseract/zxing/leptonica）=====
# 默认不入库，保持仓库轻量；如需"克隆即可构建"可移除此段。
thirdparty/

# ===== IDE / 工具目录 =====
.codex/
.cursor/
.trae-html-share-packages/
.qtcreator/
.reasonix/
.agents/
# .github 默认忽略；仅放行经过验证的 CI 工作流（避免未验证的脚手架被误触发）
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml
!.github/workflows/repo-hygiene.yml

# ===== 操作系统垃圾文件 =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ===== 编辑器 / VS 临时文件 =====
*.suo
*.user
*.user.*
.vs/

# ===== 杂项（疑似误生成的文件）=====
clear()

# ===== 第三方安装包（不应入库）=====
tools/opencv-4.13.0-windows.exe

# ===== 临时脚本（含敏感凭据，严禁入库）=====
.push-*.ps1
*.push-*.ps1

# ===== CI 运行产物（tools/ci.ps1 生成）=====
ci-*.log
ci-*.txt

# local verification temp artifacts (never commit)
ci-tmp/
ci-build-local.log
ci-test-local.txt
ci-run.err
ci-run.out
ci-activate-test.ps1
.ci-cleanup.ps1
.ci2.ps1
Testing/
ci-*
diag-*

# 本地门禁/探针临时文件（点号前缀，不随仓流转）
.ci*.ps1
.probe*.ps1
.git-commit-msg.txt
logs/
data/
